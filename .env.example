# Local Gemini development (Cloud Run should use Google application credentials)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=false

# Grafana Cloud Configuration
GRAFANA_URL=https://your-instance.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=your-service-account-token
MCP_GRAFANA_COMMAND=mcp-grafana

# Grafana Cloud OTLP ingestion (Connections > OpenTelemetry in your stack)
# Use a token scoped only to metrics:write and logs:write.
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-your-region.grafana.net/otlp
GRAFANA_CLOUD_OTLP_USERNAME=your-stack-instance-id
GRAFANA_CLOUD_OTLP_TOKEN=your-write-only-access-policy-token

# App Configuration
PORT=8000
LOG_LEVEL=info
ENABLE_CLOUD_TELEMETRY=false
# Required for state changes, Gemini investigations, and Google ADK endpoints.
STAGEHAND_ADMIN_TOKEN=generate-a-long-random-operator-token
